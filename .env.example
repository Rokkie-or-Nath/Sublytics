# ─── Sublytics Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in your real values
# NEVER commit .env — it is in .gitignore

# ─── Supabase ──────────────────────────────────────────────────────────────
# 1. Go to https://supabase.com → your project → Settings → API
# 2. Copy "Project URL" and "anon public" key (NOT the service_role key)
# The anon key is safe to ship in frontend code — RLS enforces security.
# NEVER use the service_role key in frontend code — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
