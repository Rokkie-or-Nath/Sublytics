# ─── Sublytics Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# Application settings
VITE_APP_TITLE=Sublytics
VITE_APP_DESCRIPTION=Subscription Intelligence Platform

# ─── EmailJS (for sending real verification emails) ───────────────────────
# 1. Sign up free at https://www.emailjs.com/
# 2. Go to Account > API Keys → copy your Public Key
# 3. Go to Email Services > Add New Service → connect Gmail/Outlook/etc.
# 4. Go to Email Templates > Create New Template:
#    - Subject: "Your Sublytics Verification Code"
#    - Content (HTML):
#      <h2>Welcome to Sublytics!</h2>
#      <p>Your verification code is: <strong>{{code}}</strong></p>
#      <p>This code expires in 10 minutes.</p>
#      <p>If you didn't create an account, ignore this email.</p>
# 5. Fill in the three values below:

# VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
# VITE_EMAILJS_SERVICE_ID=your_service_id_here
# VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# API (when connecting to a real backend)
# VITE_API_URL=https://api.sublytics.com
# VITE_API_KEY=your-api-key-here

# Feature flags
# VITE_ENABLE_EMAIL_SCANNING=false
# VITE_ENABLE_REAL_AUTH=false

# Analytics (optional)
# VITE_ANALYTICS_ID=