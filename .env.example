# ─── Sublytics Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in your real values
# NEVER commit .env — it is in .gitignore
#
# ⚠ SECURITY NOTE: supabase URL & anon key
# The VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY values ARE visible to
# anyone who opens the browser's DevTools Network tab. This is by design.
# Supabase's "anon key" is a public credential — it's not a secret.
# Row Level Security (RLS) policies on each table are what protect your
# users' data, NOT hiding the anon key.
#
# NEVER use the service_role key here — it bypasses RLS entirely.

# ─── Supabase ──────────────────────────────────────────────────────────────
# 1. Go to https://supabase.com → your project → Settings → API
# 2. Copy "Project URL" and "anon public" key

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
